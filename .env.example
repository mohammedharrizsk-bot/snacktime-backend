# =====================================================================
# SNACK TIME — College Server Environment Configuration Template
# Copy this file to .env on your college server and set values.
# =====================================================================

# Server Port
PORT=3000

# Environment Mode ('development' or 'production')
NODE_ENV=production

# MySQL Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASS=your_mysql_password
DB_NAME=snacktime_db

# Cryptographically Secure JWT Secret Key (min 32 chars)
JWT_SECRET=sece_snacktime_secure_jwt_secret_key_2026_campus_canteen

# Allowed CORS Origin for WebSockets & API
CORS_ORIGIN=https://snacktime.sece.ac.in

# Email Service Configuration for Password Recovery (Nodemailer)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=snacktime.sece@gmail.com
SMTP_PASS=your_email_app_password
